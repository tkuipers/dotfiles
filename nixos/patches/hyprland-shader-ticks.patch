+void IHyprRenderer::setScreenShaderAnimated(bool animated) {
+    m_screenShaderAnimated = animated;
+    for (auto const& m : g_pCompositor->m_monitors) {
+        if (!m->m_enabled)
+            continue;
+        m->resources()->invalidateMirrorFB(); // the next frame refills it completely
+        damageMonitor(m);
+    }
+    if (animated && m_shaderTickTimer)
+        m_shaderTickTimer->updateTimeout(std::chrono::milliseconds(1));
+}
+
+void IHyprRenderer::ticksTrace(const std::string& line) {
+    static FILE* f       = nullptr;
+    static auto  checked = std::chrono::steady_clock::time_point{};
+    static bool  on      = false;
+    const auto   now     = std::chrono::steady_clock::now();
+    if (now - checked > std::chrono::seconds(1)) {
+        checked = now;
+        on      = access("/tmp/hypr-ticks-trace", F_OK) == 0;
+        if (on && !f)
+            f = fopen("/tmp/hypr-ticks.log", "a");
+        else if (!on && f) {
+            fclose(f);
+            f = nullptr;
+        }
+    }
+    if (!on || !f)
+        return;
+    fprintf(f, "%.4f %s\n", m_globalTimer.getSeconds(), line.c_str());
+    fflush(f);
+}
+
+static std::string ticksBox(const CRegion& r) {
+    if (r.empty())
