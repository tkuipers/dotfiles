+bool IHyprRenderer::shaderTicksActive(PHLMONITOR monitor) {
+    static auto PDAMAGETRACKINGMODE = CConfigValue<Config::INTEGER>("debug:damage_tracking");
+    return m_screenShaderAnimated && *PDAMAGETRACKINGMODE == DAMAGE_TRACKING_FULL && !m_crashingInProgress && monitor && monitor->m_enabled && !monitor->isMirror();
+}
