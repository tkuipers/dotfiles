{
  "document": {
    "color": "#cdd6f4",
    "block_prefix": "\n",
    "block_suffix": "\n",
    "margin": 2
  },
  "block_quote": {
    "color": "#a6adc8",
    "indent": 1,
    "indent_token": "\u2502 "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "color": "#b4befe",
    "bold": true,
    "block_suffix": "\n"
  },
  "h1": {
    "color": "#cba6f7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### "
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#585b70",
    "format": "\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n"
  },
  "item": {
    "block_prefix": "\u2022 "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[\u2713] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#74c7ec",
    "underline": true
  },
  "link_text": {
    "color": "#89b4fa",
    "bold": true
  },
  "image": {
    "color": "#f5c2e7",
    "underline": true
  },
  "image_text": {
    "color": "#a6adc8",
    "format": "Image: {{.text}} \u2192"
  },
  "code": {
    "color": "#fab387",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#cdd6f4"
      },
      "error": {
        "color": "#f38ba8"
      },
      "comment": {
        "color": "#7f849c"
      },
      "comment_preproc": {
        "color": "#f5c2e7"
      },
      "keyword": {
        "color": "#cba6f7"
      },
      "keyword_reserved": {
        "color": "#cba6f7"
      },
      "keyword_namespace": {
        "color": "#cba6f7"
      },
      "keyword_type": {
        "color": "#f9e2af"
      },
      "operator": {
        "color": "#89dceb"
      },
      "punctuation": {
        "color": "#9399b2"
      },
      "name": {
        "color": "#cdd6f4"
      },
      "name_builtin": {
        "color": "#f38ba8"
      },
      "name_tag": {
        "color": "#cba6f7"
      },
      "name_attribute": {
        "color": "#f9e2af"
      },
      "name_class": {
        "color": "#f9e2af"
      },
      "name_constant": {
        "color": "#fab387"
      },
      "name_decorator": {
        "color": "#f5c2e7"
      },
      "name_exception": {
        "color": "#f38ba8"
      },
      "name_function": {
        "color": "#89b4fa"
      },
      "name_other": {
        "color": "#cdd6f4"
      },
      "literal": {
        "color": "#cdd6f4"
      },
      "literal_number": {
        "color": "#fab387"
      },
      "literal_date": {
        "color": "#fab387"
      },
      "literal_string": {
        "color": "#a6e3a1"
      },
      "literal_string_escape": {
        "color": "#f5c2e7"
      },
      "generic_deleted": {
        "color": "#f38ba8"
      },
      "generic_inserted": {
        "color": "#a6e3a1"
      },
      "generic_subheading": {
        "color": "#b4befe"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_strong": {
        "bold": true
      }
    }
  },
  "definition_description": {
    "block_prefix": "\n\u2192 "
  }
}
