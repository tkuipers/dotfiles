# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# The look of everything: mocha or aura. Change it, then reload sway (Alt+Shift+c).
# set $theme mocha
set $theme aura

set {
    $mod Mod1
    $term alacritty
    # $menu bemenu.sh | xargs swaymsg exec --
    # $launcher bemenu_launcher.sh | xargs swaymsg exec --
    $launcher wofi &
    $browser firefox-bin
    $file_manager footclient nnn
    $wallpapers_path $HOME/Pictures/Wallpapers-Mocha
}

set {
    $left h
    $down j
    $up k
    $right l
}

include ~/.config/sway/themes/$theme.conf

# Colors
# Class			border		background	text		indicator	child_border
client.focused		$lavender	$base		$text		$rosewater	$lavender
client.focused_inactive	$overlay0	$base		$text		$overlay0	$overlay0
client.unfocused	$surface1	$mantle		$subtext0	$surface1	$surface1
client.urgent		$peach		$base		$peach		$overlay0	$peach
client.placeholder	$overlay0	$base		$text		$overlay0	$overlay0
client.background	$base

seat seat0 {
    xcursor_theme catppuccin-mocha-lavender-cursors 24
    hide_cursor when-typing enable
}

# Media keys from Windows go to the Linux player
exec $HOME/.local/bin/win-media-keys
exec $HOME/.local/bin/health-log
# Clipboard: both ways with Windows, and a history
exec $HOME/.local/bin/win-to-clipboard
exec wl-paste --type text --watch $HOME/.local/bin/clipboard-to-win text
exec wl-paste --type image/png --watch $HOME/.local/bin/clipboard-to-win image
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image/png --watch cliphist store
# Launch terminal on workspace 2 at startup
exec $term --class startup-term
# Launch Teams on workspace 4 at startup
exec teams-for-linux
exec prospect-mail
# The portals run under the user manager and need to find this session
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
# Notifications
exec env GSK_RENDERER=cairo swaync -s $HOME/.local/state/theme/swaync/style.css
exec_always $HOME/.local/bin/theme-apply
# Window switcher behind the clock
exec swayrd
# Turn unfocused windows to glass
exec $HOME/.local/bin/glass-unfocused
# Cycle wallpapers on each output, fading between them
exec awww-daemon
exec $HOME/.local/bin/wallpaper-cycle
workspace 1 output Virtual-1
workspace 2 output Virtual-2
# Misc optioms
focus_follows_mouse yes
floating_modifier $mod normal
floating_maximum_size 1366 x 768
default_orientation auto


# Aesthetics
titlebar_border_thickness 2
title_align center

gaps {
    inner 5
    outer -2
}

font pango:JetBrainsMono Nerd Font 11

# SwayFX
corner_radius 8
titlebar_separator disable

blur enable
blur_passes 2
blur_radius 4
blur_noise 0.02
blur_saturation 1.1

shadows enable
shadows_on_csd disable
shadow_blur_radius 24
shadow_offset 0 4

layer_effects "waybar" {
    blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 8;
}
layer_effects "wofi" {
    blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 10;
}
layer_effects "swaync-control-center" {
    blur enable; blur_ignore_transparent enable; shadows enable; corner_radius 16;
}
layer_effects "swaync-notification-window" {
    blur enable; blur_ignore_transparent enable; corner_radius 8;
}
layer_effects "logout_dialog" {
    blur enable;
}

# The left monitor is the first viewer, the right one the second. Sizes follow
# the viewers' windows, so they fit at any desk.
exec ~/.local/bin/fit-outputs

input "7531:260:Weaselway_pointer" map_to_output Virtual-1
input "7531:260:Weaselway_pointer_2" map_to_output Virtual-2

output HDMI-A-1 {
    pos 0 0
}

output DP-2 {
    pos 1920 0
}

# Assign applications to specific workspaces
assign [app_id="startup-term"] workspace number 2
assign [class="Brave-browser"] workspace number 1
assign [app_id="brave-browser"] workspace number 1
assign [class="Code"] workspace number 3
assign [app_id="code"] workspace number 3
assign [class="code-oss"] workspace number 3
assign [app_id="code-oss"] workspace number 3
assign [class="Cursor"] workspace number 3
assign [app_id="cursor"] workspace number 3
assign [class="neovide"] workspace number 3
assign [app_id="neovide"] workspace number 3
assign [class="nvim-qt"] workspace number 3
assign [app_id="nvim-qt"] workspace number 3
assign [class="microsoft teams"] workspace number 4
assign [app_id="teams"] workspace number 4
assign [class="teams"] workspace number 4
assign [app_id="microsoft-teams"] workspace number 4
assign [class="teams-for-linux"] workspace number 4
assign [app_id="teams-for-linux"] workspace number 4
assign [app_id="prospect-mail"] workspace number 6
assign [class="Cider"] workspace number 5
assign [app_id="cider"] workspace number 5
assign [app_id="Cider"] workspace number 5

for_window {
    [app_id="com.gabm.satty"] floating enable
    [app_id="scratchterm"] floating enable, resize set 70 ppt 60 ppt, move position center, move scratchpad, scratchpad show
    [app_id="scratchnotes"] floating enable, resize set 30 ppt 45 ppt, move position center, move scratchpad, scratchpad show
    [app_id="scratchmixer"] floating enable, resize set 45 ppt 55 ppt, move position center, move scratchpad, scratchpad show
    [window_role="pop-up"] floating enable
    [window_role="bubble"] floating enable
    [window_role="dialog"] floating enable
    [window_type="dialog"] floating enable
    [window_role="task_dialog"] floating enable

    [title="(?:Open|Save) (?:File|Folder|As)"] floating enable, sticky enable
    [title="File Upload"] floating enable, sticky enable
    [title="Firefox — Sharing Indicator"] floating enable
    [title="^Picture-in-Picture"] floating enable, sticky enable

    [class="qemu-system-x86_64"] floating enable, inhibit_idle focus

    [shell="xwayland"] title_format "%title [XWayland]"

    [app_id="firefox"] inhibit_idle fullscreen, max_render_time off
    [app_id="qemu|zenmonitor|mpv|imv|timeshift-gtk"] floating enable, inhibit_idle visible, max_render_time off
    [app_id="telegram-desktop"] floating enable
}



bindsym {
    $mod+greater move workspace to output right
    $mod+less move workspace to output left
    $mod+Return exec $term
    $mod+Shift+q kill
    $mod+d exec $launcher
    $mod+Shift+c reload
    $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
    $mod+Shift+s exec $HOME/.local/bin/screenshot
    $mod+$left focus left
    $mod+$down focus down
    $mod+$up focus up
    $mod+$right focus right
    $mod+Left focus left
    $mod+Down focus down
    $mod+Up focus up
    $mod+Right focus right
    $mod+Shift+$left move left
    $mod+Shift+$down move down
    $mod+Shift+$up move up
    $mod+Shift+$right move right
    $mod+Shift+Left move left
    $mod+Shift+Down move down
    $mod+Shift+Up move up
    $mod+Shift+Right move right
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9
    $mod+0 workspace number 10

    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
    $mod+Shift+0 move container to workspace number 10

    $mod+b splith
    $mod+v splitv
    $mod+Shift+v exec $HOME/.local/bin/clipboard-pick
    $mod+Shift+m exec $HOME/.local/bin/scratch-toggle mixer
    
    $mod+s layout stacking
    $mod+w layout tabbed
    $mod+e layout toggle split
    $mod+f fullscreen
    
    $mod+Shift+space floating toggle
    $mod+space exec $HOME/.local/bin/scratch-tap
    $mod+a focus parent

    $mod+Shift+minus move scratchpad
    $mod+minus scratchpad show
}

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bar {
    swaybar_command /home/nixos/.local/bin/waybar-themed
}

include /etc/sway/config.d/*
