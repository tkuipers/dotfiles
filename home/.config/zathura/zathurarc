include /home/nixos/.local/state/theme/zathura/colors
set highlight-color           "rgba(249,226,175,0.35)"
set highlight-active-color    "rgba(245,194,231,0.45)"

# Copy selections to the normal clipboard, so they reach Windows too
set selection-clipboard clipboard
set window-title-basename true
set guioptions s
set scroll-page-aware true
set adjust-open width
