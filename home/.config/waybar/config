{
	"layer": "top",
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 2,
	"modules-left": [
        "sway/workspaces"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"idle_inhibitor",
		"memory",
		"cpu",
		"backlight",
		"battery",
		"custom/spotify",
        "custom/power"
	],
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{name}: {icon}",
        "format-icons": {
            "urgent": "󰖨",
            "focused": "",
            "default": "",
            "visible": ""
      }
    },
	"memory": {
		"interval": 1,
		"format": "<span foreground='#94e2d5' font_weight='normal'>󰰑</span> {percentage}%",
		"states": {
			"warning": 80,
			"critical": 90
		},
		"tooltip": true,
		"tooltip-format": "Memory: {used:0.1f}G/{total:0.1f}G"
	},
	"cpu": {
		"interval": 1,
		"format": "<span foreground='#cba6f7' font_weight='normal'>󰯳</span> {usage}%",
		"tooltip": true
	},
	"cpu#load": {
		"interval": 1,
		"format": "<span foreground='#89dceb' font_weight='normal'>\uf3a9</span> {load}",
		"tooltip": false
	},
	"clock": {
		"format": "<span foreground='#74c7ec' font_weight='normal'></span> {:%I:%M %p  %A %d %b}",
		"tooltip": false
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "<span foreground='#a6e3a1' font_weight='normal'>󰖨</span>",
			"deactivated": "<span foreground='#a6e3a1' font_weight='normal'></span>"
		},
		"tooltip": true
	},
	"network": {
		"interval": 1,
		"format-ethernet": "<span foreground='#b4befe' font_weight='normal'>\uf335</span> {ifname}",
		"format-wifi": "<span foreground='#b4befe' font_weight='normal'>\uf430</span> {essid}",
		"format-linked": "<span foreground='#b4befe' font_weight='normal'>\uf431</span> {essid} (No IP)",
		"format-disconnected": "<span foreground='#b4befe' font_weight='normal'>\uf431</span> Disconnected",
		"max-length": 28,
		"tooltip": true,
		"tooltip-format": "{ipaddr}/{cidr}"
	},
	"backlight": {
		"format": "<span foreground='#94e2d5' font='lucide 14' rise='-1pt'>{icon}</span> {percent}%",
		"format-icons": ["\uf3d5", "\uf3d6", "\uf3d4"],
		"on-click": "brightness.sh -s 3 &",
		"on-click-right": "brightness.sh -s 50 &",
		"on-scroll-up": "brightness.sh -i &",
		"on-scroll-down": "brightness.sh -d &",
		"smooth-scrolling-threshold": 5
	},
	"battery": {
		"states": {
			"warning": 20,
			"critical": 10
		},
		"format": "<span foreground='#cba6f7' font_weight='normal'>{icon}</span> {capacity}%",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"format-charging": "<span foreground='#cba6f7' font_weight='normal'>󰂄</span> {capacity}%",
		"tooltip": true
	},
    "custom/power": {
        "format": "<span foreground='#94e2d5' font_weight='normal'></span>",
        "format-icons": ["\uf3d5", "\uf3d6", "\uf3d4"],
        "on-click": "swaynag -t warning -m 'Power Menu Options' -b 'Shutdown'  'shutdown -h now' -b 'Restart' 'shutdown -r now' -b 'Logout' 'swaymsg exit' -b 'Hibernate' 'systemctl hibernate' --background=#005566 --button-background=#009999 --button-border=#002b33 --border-bottom=#002b33",
        "tooltip": false
    },
    "custom/spotify": {
        "format": "{icon} {}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "interval": 30,
        "on-click": "playerctl -p spotify play-pause",
        "on-click-right": "killall spotify",
        "smooth-scrolling-threshold": 10,
        "on-scroll-up" : "playerctl -p spotify next",
        "on-scroll-down" : "playerctl -p spotify previous",
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
        "exec-if": "pgrep spotify"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
}

