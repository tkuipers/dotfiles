{
    "layer": "top",
    "margin-top": 3,
    "margin-left": 3,
    "margin-right": 3,
    "margin-bottom": 2,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "clock",
        "custom/agenda"
    ],
    "modules-right": [
        "custom/media",
        "custom/camera",
        "idle_inhibitor",
        "custom/weather",
        "memory",
        "cpu",
        "battery",
        "custom/notification",
        "custom/power"
    ],
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "󰖟",
            "2": "󰆍",
            "3": "󰅩",
            "4": "󰊻",
            "5": "󰝚",
            "6": "󰇮",
            "default": "󰧞"
        }
    },
    "memory": {
        "interval": 1,
        "format": "<span foreground='#94e2d5' font_weight='normal'>󰰑</span> {percentage}%",
        "states": {
            "warning": 80,
            "critical": 90
        },
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}G/{total:0.1f}G"
    },
    "cpu": {
        "interval": 1,
        "format": "<span foreground='#cba6f7' font_weight='normal'>󰯳</span> {usage}%",
        "tooltip": true
    },
    "clock": {
        // Waybar's own zone data still has Alberta on MST; Regina is the same UTC-6 all year
        "timezone": "America/Regina",
        "min-length": 21,
        "align": 0.5,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "weekdays": "<span color='#74c7ec'>{}</span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "today": "<span color='#f5c2e7'><b><u>{}</u></b></span>"
            }
        },
        "format": "<span foreground='#74c7ec' font_weight='normal'></span> {:%H:%M  %a %d %b}",
        "tooltip": false,
        "on-click": "swayr switch-window"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "<span foreground='#a6e3a1' font_weight='normal'>󰖨</span>",
            "deactivated": "<span foreground='#a6e3a1' font_weight='normal'></span>"
        },
        "tooltip": true
    },
    "custom/weather": {
        "exec": "$HOME/.local/bin/weather-now --bar",
        "return-type": "json",
        "interval": 300
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "<span foreground='#cba6f7' font_weight='normal'>{icon}</span> {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "<span foreground='#cba6f7' font_weight='normal'>󰂄</span> {capacity}%",
        "tooltip": true
    },
    "custom/power": {
        "format": "<span foreground='#94e2d5' font_weight='normal'></span>",
        "on-click": "$HOME/.local/bin/power-menu",
        "tooltip": false
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂞",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂞",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "$HOME/.local/bin/notification-panel",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/camera": {
        "exec": "$HOME/.local/bin/camera-toggle status",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "$HOME/.local/bin/camera-toggle"
    },
    "custom/agenda": {
        "format": "<span foreground='#cba6f7' font_weight='normal'>󰃭</span> {text}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/agenda",
        "min-length": 21,
        "max-length": 21,
        "align": 0.5,
        "on-click": "$HOME/.local/bin/agenda pick",
        "on-click-right": "swaymsg '[app_id=\"prospect-mail\"] focus'"
    },
    "custom/media": {
        "format": "<span font_weight='normal'>{icon}</span> {text}",
        "format-icons": {
            "playing": "<span foreground='#a6e3a1'>󰐊</span>",
            "paused": "<span foreground='#f9e2af'>󰏤</span>",
            "default": "<span foreground='#f5c2e7'>󰝚</span>"
        },
        "return-type": "json",
        "exec": "$HOME/.local/bin/media-scroll",
        "escape": true,
        "tooltip": false,
        "on-click": "$HOME/.local/bin/media-scroll toggle",
        "on-click-right": "$HOME/.local/bin/media-scroll focus"
    }
}
