{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/weasel.txt",
    "color": { "1": "#b4befe", "2": "#cba6f7", "3": "#f5c2e7" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#b4befe", "title": "#cba6f7" }
  },
  "modules": [
    "title",
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "shell", "key": " shell" },
    { "type": "gpu", "key": "󰾲 gpu" },
    { "type": "memory", "key": " mem" },
    { "type": "uptime", "key": "󰅐 up" },
    "colors"
  ]
}
