#!/usr/bin/env bash
# Each viewer asks for the size of its window. dxgdrm records that but sway never
# picks it up, so keep the outputs on it, side by side, whichever monitors these are.
while sleep 2; do
  outputs=$(swaymsg -t get_outputs) || exit
  x=0
  for n in 1 2; do
    connector=$(echo /sys/class/drm/card*-Virtual-$n)
    [ "$(cat "$connector/status")" = connected ] || continue
    read -r mode < "$connector/modes"
    [ -n "$mode" ] || continue
    current=$(jq -r --arg name "Virtual-$n" \
      '.[] | select(.name == $name) | "\(.current_mode.width)x\(.current_mode.height) \(.rect.x)"' <<< "$outputs")
    [ "$current" = "$mode $x" ] || swaymsg -- output "Virtual-$n" mode --custom "$mode@60Hz" pos "$x" 0 > /dev/null
    x=$((x + ${mode%x*}))
  done
done
