#!/usr/bin/env bash
# The track for the bar. One too long to fit rests on its start, then scrolls through.
# `media-scroll focus` goes to the app that is playing it.
width=18
track() { playerctl metadata --format '{{ title }} - {{ artist }}' 2> /dev/null; }

if [ "$1" = focus ]; then
  player=$(playerctl metadata --format '{{ playerInstance }}')
  # Electron apps like Cider call themselves chromium.instance<pid>.
  case "$player" in
    *.instance*) swaymsg "[pid=${player##*instance}] focus" ;;
    *) swaymsg "[app_id=\"(?i)${player%%.*}\"] focus" ;;
  esac
  exit
fi

while :; do
  text=$(track)
  echo "${text:0:width}"
  sleep 2.5
  (( ${#text} > width )) || continue

  loop="$text   $text"
  for ((i = 1; i <= ${#text} + 3; i++)); do
    echo "${loop:i:width}"
    sleep 0.125
    # A new track shouldn't wait for this one to finish scrolling.
    (( i % 8 )) || [ "$(track)" = "$text" ] || break
  done
done
