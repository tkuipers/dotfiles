#!/usr/bin/env bash
# The track for the bar. One too long to fit rests on its start, then scrolls through.
# `media-scroll focus` goes to the app that is playing it, `toggle`, `next`, `previous` and `stop` control it.
width=18

# The player to show: the one playing, or else a paused one. Browsers count as
# players too, and sit there stopped.
current() {
  playerctl -a --format '{{ lc(status) }} {{ playerInstance }}' status 2> /dev/null |
    awk '$1 == "playing" { print; found = 1; exit } $1 == "paused" && !paused { paused = $0 }
         END { if (!found && paused) print paused }'
}
status() { current | cut -d' ' -f1; }
instance() { current | cut -d' ' -f2; }
track() {
  local player
  player=$(instance)
  [ -n "$player" ] && playerctl -p "$player" metadata --format '{{ title }} - {{ artist }}' 2> /dev/null
}

case $1 in
  toggle | next | previous | stop)
    command=$1
    [ "$1" = toggle ] && command=play-pause
    player=$(instance)
    [ -n "$player" ] && exec playerctl -p "$player" "$command"
    exec playerctl "$command"
    ;;
esac

if [ "$1" = focus ]; then
  player=$(instance)
  # Electron apps like Cider call themselves chromium.instance<pid>.
  case "$player" in
    *.instance*) "$HOME/.local/bin/wm" focus-pid "${player##*instance}" ;;
    *) "$HOME/.local/bin/wm" focus "${player%%.*}" ;;
  esac
  exit
fi

# How far through the track, in steps of 5%, for the line under the pill
progress() {
  local player position length
  player=$(instance)
  [ -n "$player" ] || return
  read -r position length < <(playerctl -p "$player" metadata --format '{{ position }} {{ mpris:length }}' 2> /dev/null)
  [[ $position =~ ^[0-9]+$ && $length =~ ^[0-9]+$ ]] && (( length > 0 )) || return
  echo $(( (position * 20 / length) * 5 ))
}

# The hover text: the whole title, the artist and album, and the time
details() {
  local player
  player=$(instance)
  [ -n "$player" ] && playerctl -p "$player" metadata --format \
    $'{{ title }}\n{{ artist }}{{ album != "" ? " — " : "" }}{{ album }}\n{{ duration(position) }} / {{ duration(mpris:length) }}' 2> /dev/null
}

# One line of JSON for waybar: the text, and the state that picks the icon.
show() {
  local percent
  percent=$(progress)
  jq -cn --arg text "$1" --arg state "$state" --arg tooltip "$(details)" --arg step "${percent:+p$percent}" \
    '{text: $text, alt: $state, tooltip: $tooltip, class: ([$state, $step] | map(select(. != "")))}'
}

while :; do
  text=$(track)
  state=$(status)
  show "${text:0:width}"
  # Rests in short steps, so pausing shows up at once.
  for _ in 1 2 3 4 5; do
    sleep 0.5
    now=$(status)
    [ "$now" = "$state" ] && continue
    state=$now
    show "${text:0:width}"
  done
  (( ${#text} > width )) || continue

  loop="$text   $text"
  for ((i = 1; i <= ${#text} + 3; i++)); do
    show "${loop:i:width}"
    sleep 0.125
    # A new track shouldn't wait for this one to finish scrolling.
    if ! (( i % 4 )); then
      state=$(status)
      [ "$(track)" = "$text" ] || break
    fi
  done
done
