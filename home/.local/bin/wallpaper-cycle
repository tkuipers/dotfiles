#!/usr/bin/env bash
# Give each output a wallpaper that suits the weather every 15-30 minutes,
# static or animated.
# Exits once the compositor is gone, so it never outlives the session.

# With --now, does one pass and stops, for theme-apply. Each theme has its own folders.

# Half the time an animated one, when there are any and wallpaper-live allows it.
pick() {
  local theme wallpapers live folder
  theme=$(cat "$HOME/.local/state/theme/current")
  wallpapers=$HOME/Pictures/Wallpapers-${theme^}
  live=$wallpapers-Live
  folder=$wallpapers
  [ -e "$HOME/.cache/wallpapers-static" ] ||
    { ((RANDOM % 2)) && [ -n "$(find "$live" -name '*.gif' 2>/dev/null | head -n 1)" ] && folder=$live; }
  "$HOME/.local/bin/wallpaper-pick" "$folder"
}

change_all() {
  local output
  for output in $(awww query | sed -n 's/^: \([^:]*\):.*/\1/p'); do
    awww img --outputs "$output" --resize crop --transition-type fade \
      --transition-duration 2 --transition-fps 60 "$(pick)"
  done
}

# awww keeps every GIF's decoded frames forever, once per output size, so it
# reached 64 GB. Keeps the newest 5 GB; dropped ones are decoded again when played.
prune_cache() {
  local total=0 size file _
  while IFS=' ' read -r -d '' _ size file; do
    ((total += size))
    if ((total > 5 * 1024 ** 3)); then rm -f -- "$file"; fi
  done < <(find "$HOME/.cache/awww" -type f -name '*__*' -printf '%T@ %s %p\0' 2>/dev/null | sort -zrn)
}

if [ "$1" = --now ]; then
  change_all
  prune_cache
  exit
fi

# Let startup finish creating outputs before the first pass
sleep 5
until awww query > /dev/null 2>&1; do sleep 1; done

while [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do
  change_all
  prune_cache
  sleep $((900 + RANDOM % 900))
done
