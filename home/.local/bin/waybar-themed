#!/usr/bin/env bash
# Waybar reading the copies theme-apply renders, with the workspaces module of the
# running compositor. sway's swaybar_command can't take flags.
state=$HOME/.local/state/theme/waybar
config=$state/config
wm=$("$HOME/.local/bin/wm" name)
[ "$wm" != sway ] && [ -f "$state/config-$wm" ] && config=$state/config-$wm
exec waybar -c "$config" -s "$state/style.css" "$@"
