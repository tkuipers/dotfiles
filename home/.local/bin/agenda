#!/bin/bash
# Outlook calendar for the bar. Windows' Outlook is asked over COM, which starts
# it hidden for a few seconds, so it is only asked every 15 minutes.
#   agenda        JSON lines for waybar: the current or next meeting, long names scrolling
#   agenda pick   choose a meeting; one with a Teams link joins, others open mail
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
cache=$run/agenda.tsv
powershell=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

script=$(cat <<'PS'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$items = (New-Object -ComObject Outlook.Application).Session.GetDefaultFolder(9).Items
# In this order: recurring meetings do not expand otherwise
$items.Sort('[Start]')
$items.IncludeRecurrences = $true
$from = (Get-Date).Date; $to = $from.AddDays(2)
# Spelled out: Outlook reads 11/5 as the 11th of May here
$format = 'MMMM d, yyyy h:mm tt'
$found = $items.Restrict("[Start] >= '" + $from.ToString($format) + "' AND [Start] < '" + $to.ToString($format) + "'")
foreach ($item in $found) {
  if ($item.Start -ge $to) { break }
  # All day, declined, cancelled
  if ($item.AllDayEvent -or $item.ResponseStatus -eq 4 -or $item.MeetingStatus -in 5, 7) { continue }
  $link = ''
  if ($item.Body -match 'https://teams\.microsoft\.com/(l/meetup-join|meet)/[^\s<>"]+') { $link = $Matches[0] }
  $subject = $item.Subject -replace '[\t\r\n]', ' '
  $start = ([DateTimeOffset]$item.Start).ToUnixTimeSeconds()
  $end = ([DateTimeOffset]$item.End).ToUnixTimeSeconds()
  [Console]::Out.WriteLine("$start`t$end`t$subject`t$link")
}
PS
)

fetch() {
  local tmp
  exec 7>"$run/agenda.lock"
  flock -n 7 || return
  tmp=$(mktemp "$run/agenda.XXXXXX")
  if (cd /mnt/c && timeout 60 "$powershell" -NoProfile -NonInteractive -EncodedCommand \
    "$(iconv -f utf-8 -t utf-16le <<<"$script" | base64 -w0)" </dev/null 2>/dev/null) | tr -d '\r' | sort -n >"$tmp" &&
    [ "${PIPESTATUS[0]}" = 0 ]; then
    mv "$tmp" "$cache"
  else
    rm -f "$tmp"
  fi
  exec 7>&-
}

stale() { [ -z "$(find "$cache" -mmin -15 2>/dev/null)" ]; }

upcoming() {
  awk -F'\t' -v now="$(date +%s)" '$2 > now' "$cache" 2>/dev/null
}

markup() { local s=${1//&/&amp;}; s=${s//</&lt;}; printf '%s' "${s//>/&gt;}"; }

# The current or nearest meeting, today or tomorrow, into when and subject; the
# tooltip lists today.
meeting() {
  local now today start end link line
  now=$(date +%s)
  today=$(date +%F)
  when='' subject='' tooltip=''
  while IFS=$'\t' read -r start end name link; do
    if [ -z "$when" ]; then
      subject=$name
      if ((start <= now)); then
        when=now
      elif [ "$(date -d "@$start" +%F)" = "$today" ]; then
        when=$(date -d "@$start" +%H:%M)
      else
        when=$(date -d "@$start" '+%a %H:%M')
      fi
    fi
    [ "$(date -d "@$start" +%F)" = "$today" ] || continue
    line="$(date -d "@$start" +%H:%M)  $(markup "$name")"
    tooltip+="${tooltip:+$'\n'}$line"
  done < <(upcoming)
  tip=$(printf '%s' "${tooltip:-Nothing else today}" | jq -Rs .)
}

# One line of JSON for waybar.
emit() {
  local text
  text=$(markup "$1")
  text=${text//\\/\\\\}
  printf '{"text":"%s","tooltip":%s}\n' "${text//\"/\\\"}" "$tip"
}

if [ "$1" = pick ]; then
  stale && fetch
  list=$(upcoming)
  choice=$(while IFS=$'\t' read -r start _ subject link; do
    printf '%s  %s%s\n' "$(date -d "@$start" '+%a %H:%M')" "$subject" "${link:+  (Teams)}"
  done <<<"$list" | wofi --dmenu --prompt Meetings) || exit 0
  n=$(while IFS=$'\t' read -r start _ subject link; do
    printf '%s  %s%s\n' "$(date -d "@$start" '+%a %H:%M')" "$subject" "${link:+  (Teams)}"
  done <<<"$list" | grep -nxF -- "$choice" | head -n 1 | cut -d: -f1)
  link=$(sed -n "${n}p" <<<"$list" | cut -f4)
  if [ -n "$link" ]; then
    teams-for-linux "$link" &
    "$HOME/.local/bin/wm" focus teams-for-linux
  else
    "$HOME/.local/bin/wm" focus prospect-mail
  fi
  exit
fi

while :; do
  stale && fetch
  meeting
  if [ -z "$when" ]; then
    emit 'No meetings'
    sleep 30
    continue
  fi

  # 13 characters of name, fewer beside a longer time, for the pill's width
  room=$((19 - ${#when} - 1))
  ((room > 13)) && room=13
  emit "$when ${subject:0:room}"
  if ((${#subject} <= room)); then
    sleep 30
    continue
  fi

  # Too long to fit: rests on its start, then scrolls through, like media-scroll
  sleep 2.5
  loop="$subject   $subject"
  for ((i = 1; i <= ${#subject} + 3; i++)); do
    emit "$when ${loop:i:room}"
    sleep 0.125
  done
done
